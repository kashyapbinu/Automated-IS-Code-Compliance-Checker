# Provider: Gemini direct (default model gemini-3.8-flash) or OpenRouter (default google/gemini-2.5-flash)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BASE_URL=https://openrouter.ai/api/v1

# One key for all agents...
LLM_API_KEY=your_api_key_here

# ...or a key per agent (overrides LLM_API_KEY)
# ORCHESTRATOR_API_KEY=
# SPECIALIST_API_KEY=
# VALIDATOR_API_KEY=
# COMPLIANCE_API_KEY=
# FIGURE_API_KEY=

# Optional model per agent (Orchestrator/Specialist/Figure need vision)
# ORCHESTRATOR_MODEL=gemini-3.8-flash
# SPECIALIST_MODEL=gemini-3.8-flash
# VALIDATOR_MODEL=gemini-3.8-flash
# COMPLIANCE_MODEL=gemini-3.8-flash
# FIGURE_MODEL=gemini-3.8-flash

# Optional RAG settings
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# COLLECTION_NAME=is_codes_v2
# CHUNK_SIZE=700
# CHUNK_OVERLAP=150
# RETRIEVE_K=4

# Optional preprocessing limits
# PDF_DPI=200
# MAX_IMAGE_SIDE=2048
# MIN_IMAGE_SIDE=800
# MAX_PAGES=6
